{
  "name": "astrix-client",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "description": "Windows-first Minecraft launcher prototype",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"pnpm dev:electron\"",
    "dev:electron": "pnpm build:electron && wait-on http://localhost:5173 && electron .",
    "dev:web": "vite",
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "pnpm build:electron && node --test tests/*.test.cjs",
    "preview": "vite preview",
    "start": "electron . --production"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "fflate": "^0.8.3",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
